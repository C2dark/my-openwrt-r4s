# =========================================================
# NanoPi R4S (4GB) Pro 全能版专属配置
# 对应原 openwrt-lite Server 版定位
# 在 Plus 基础上，充分利用 4GB 内存打造 All-in-One 路由
# 包含: Plus 全套 + Docker + Samba4 + 磁盘挂载 + WireGuard
# =========================================================

# 继承 Plus 版本的全部核心网络与无线特性
# (由构建工作流将 plus.config 自动合入，此处声明 Pro 增量组件)

# --- 容器虚拟化套件: Docker 全家桶 ---
CONFIG_PACKAGE_luci-app-dockerman=y
CONFIG_PACKAGE_luci-i18n-dockerman-zh-cn=y
CONFIG_PACKAGE_docker=y
CONFIG_PACKAGE_dockerd=y
CONFIG_PACKAGE_docker-compose=y
CONFIG_PACKAGE_cgroupfs-mount=y

# --- 局域网文件共享: Samba4 ---
CONFIG_PACKAGE_luci-app-samba4=y
CONFIG_PACKAGE_luci-i18n-samba4-zh-cn=y
CONFIG_PACKAGE_samba4-server=y
CONFIG_PACKAGE_wsdd2=y

# --- 存储与磁盘管理: Diskman & 文件系统工具 ---
CONFIG_PACKAGE_luci-app-diskman=y
CONFIG_PACKAGE_luci-i18n-diskman-zh-cn=y
CONFIG_PACKAGE_fdisk=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_parted=y
CONFIG_PACKAGE_btrfs-progs=y
CONFIG_PACKAGE_luci-app-filemanager=y
CONFIG_PACKAGE_luci-i18n-filemanager-zh-cn=y

# --- VPN 协议与穿透: WireGuard ---
CONFIG_PACKAGE_luci-app-wireguard=y
CONFIG_PACKAGE_luci-i18n-wireguard-zh-cn=y
CONFIG_PACKAGE_wireguard-tools=y

# --- 自动化运维与保活: Watchcat & 网络唤醒 WOL ---
CONFIG_PACKAGE_luci-app-watchcat=y
CONFIG_PACKAGE_luci-i18n-watchcat-zh-cn=y
CONFIG_PACKAGE_luci-app-wol=y
CONFIG_PACKAGE_luci-i18n-wol-zh-cn=y
