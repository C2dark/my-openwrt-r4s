# =========================================================
# NanoPi R4S (4GB) Plus 精简推荐版专属配置
# 对应原 openwrt-lite Lite 版定位
# 核心网络增强 + OpenWrt-nikki + RTL8812BU 无线驱动
# =========================================================

# --- 瑞昱 RTL8812BU (AC1200 USB 无线网卡) 专属驱动与无线管理 ---
CONFIG_PACKAGE_kmod-rtl88x2bu=y
CONFIG_PACKAGE_wpad-basic-mbedtls=y
CONFIG_PACKAGE_wireless-regdb=y
CONFIG_PACKAGE_iw=y
CONFIG_PACKAGE_iwinfo=y
CONFIG_PACKAGE_luci-app-wifischedule=y
CONFIG_PACKAGE_luci-i18n-wifischedule-zh-cn=y

# --- 现代核心代理套件: OpenWrt-nikki (基于 Mihomo 内核) ---
CONFIG_PACKAGE_luci-app-nikki=y
CONFIG_PACKAGE_nikki=y
CONFIG_PACKAGE_luci-i18n-nikki-zh-cn=y

# --- 组网与安全远程接入: Tailscale ---
CONFIG_PACKAGE_luci-app-tailscale=y
CONFIG_PACKAGE_tailscale=y
CONFIG_PACKAGE_luci-i18n-tailscale-zh-cn=y

# --- 动态域名解析: DDNS ---
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_ddns-scripts=y
CONFIG_PACKAGE_ddns-scripts-cloudflare=y
CONFIG_PACKAGE_luci-i18n-ddns-zh-cn=y

# --- 通用即插即用端口映射: UPnP ---
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_miniupnpd-nftables=y
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y

# --- 简单流控: EQoS ---
CONFIG_PACKAGE_luci-app-eqos=y
CONFIG_PACKAGE_luci-i18n-eqos-zh-cn=y

# --- 端口转发与转发工具: Socat ---
CONFIG_PACKAGE_luci-app-socat=y
CONFIG_PACKAGE_socat=y
CONFIG_PACKAGE_luci-i18n-socat-zh-cn=y

# --- 网页终端与监控: TTYD & Nlbwmon ---
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_ttyd=y
CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn=y
CONFIG_PACKAGE_luci-app-nlbwmon=y
CONFIG_PACKAGE_luci-i18n-nlbwmon-zh-cn=y
